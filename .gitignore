# Tracks files that should NOT be committed to the public GitHub repo.
# Keep credentials, local config, and app-specific secrets out of the repo.

# Local environment and credentials
.env
CLAUDE_APPLICATION_FIELDS.txt

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
dist/
build/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Local app data
settings.json
src/desktop/settings.json

# Gisto API key file (DO NOT commit)
.gisto_key

# Build-time generated keys module — contains REAL XOR-obfuscated API keys.
# This file is generated by build_keys.py and must NEVER be committed.
# The EXE (gitignored dist/) ships with real keys; committed source stays clean.
src/desktop/_built_keys.py

# Build artifacts — keys.py backup may contain real keys
src/desktop/keys.py.bak

# Python package dirs
*.egg-info/
build/
dist/

# PyInstaller spec
*.spec

# PyInstaller build log (contains paths, may reference key material)
build.log

# Local CI helper — not part of the shipped product
scripts/quick_verify.py
build.log
